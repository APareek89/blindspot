{
  "name": "blindspot",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:eval-plan": "tsx scripts/test-eval-plan.ts",
    "start:gateway": "pnpm --filter @blindspot/gateway dev",
    "start:worker": "pnpm --filter @blindspot/worker dev",
    "start:dashboard": "pnpm --filter @blindspot/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
