%% Blindspot — golden-set lifecycle: explicit source -> configure -> review -> run (takeover reviewed 2026-07-22)
%% files: apps/gateway/src/manage/golden.ts, packages/core/src/golden/agent.ts, packages/core/src/golden/service.ts, packages/core/src/golden/upload.ts, apps/dashboard/app/(app)/golden-sets/[route]/GoldenManager.tsx
%% granularity: full
flowchart TD
  S{"Choose source<br/>USER"}:::dec
  U["Read structured dataset<br/>FUNCTION · CSV, JSON or JSONL<br/>in: file/paste · out: candidate rows"]:::fn
  DOC["Read selected context documents<br/>FUNCTION · Markdown or text<br/>out: bounded context for generation"]:::fn
  CTX["Load explicitly shared app manifest<br/>DATA · product brief, prompts, architecture and selected documents"]:::data
  LIVE{"Use retained live inputs?<br/>USER · separate consent; metadata-only cannot provide content"}:::ask
  UV["Validate exact row keys and reference aliases<br/>FUNCTION · Zod<br/>out: examples or row-level error"]:::fn
  AG["Generate diverse draft examples<br/>AGENT · GOLDEN_MODEL or JUDGE_MODEL<br/>in: task + consented bounded context · out: inputs, references and rubrics"]:::agent
  AV["Validate exact count and unique prompts<br/>FUNCTION · Zod GeneratedGolden"]:::fn
  REVIEW{"Review source, consent and example count; publish?<br/>USER"}:::ask
  NV["Lock parent Route + allocate next version<br/>FUNCTION · serialized max version plus one"]:::fn
  STORE["Insert version and examples<br/>DATA · golden_sets + golden_examples"]:::data
  CUR["Curate examples<br/>FUNCTION · add, edit, delete, label, activate and version"]:::fn
  PT["Promote same-route production trace<br/>FUNCTION · reject unavailable metadata; user reviews retained content"]:::fn
  RUN["Continue to budgeted experiment<br/>FUNCTION · no provider calls before estimate + confirmation"]:::term
  GROW["Planned suggested-additions queue<br/>AGENT proposes uncertain, drifted and diverse live cases<br/>USER accepts, edits or rejects"]:::term

  PENDING{"Current file reads finished without error?<br/>FUNCTION"}:::dec
  S -- "dataset" --> U --> UV --> PENDING
  PENDING -- "yes" --> REVIEW
  PENDING -- "no" --> U
  S -- "documents" --> DOC --> AG
  S -- "connected context" --> CTX --> AG
  S -- "live traces" --> LIVE
  LIVE -- "consent and content available" --> AG
  LIVE -- "no" --> S
  AG --> AV --> REVIEW
  REVIEW -- "revise" --> S
  REVIEW -- "publish" --> NV --> STORE --> CUR --> RUN
  STORE --> PT --> CUR
  STORE -. "future growth" .-> GROW -.-> CUR

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
