%% Blindspot — golden-set lifecycle (PRD §7): seed -> grow -> curate
%% grow-from-production step is intended, not yet built
%% files: apps/gateway/src/manage/golden.ts, packages/core/src/golden/agent.ts, packages/core/src/golden/service.ts, packages/core/src/golden/upload.ts
%% granularity: full
flowchart TD
  S{"Seed path?<br/>USER chooses"}:::dec
  U["Parse upload CSV or JSONL<br/>FUNCTION · csv-parse<br/>in: file text · out: rows"]:::fn
  UV["Validate rows<br/>FUNCTION · Zod GoldenExampleInput<br/>out: examples or row-level error"]:::fn
  CTX["Optional context<br/>USER · product brief, system prompt, architecture<br/>live traces require an explicit checkbox"]:::ask
  A["Golden Set Agent<br/>AGENT · GOLDEN_MODEL or JUDGE_MODEL<br/>in: task + bounded context/sample inputs · out: input + referenceOutput + rubric xN"]:::agent
  AV["Schema-validate via generateObject<br/>FUNCTION · Zod GeneratedGolden"]:::fn
  NV["Lock parent Route + allocate next version<br/>FUNCTION · serialized max(version) + 1"]:::fn
  C["createGoldenSet + insert examples<br/>DATA · golden_sets (origin) and golden_examples"]:::data
  CUR["Curate: add / edit / delete / label / active<br/>FUNCTION · CRUD on golden_examples"]:::fn
  PT["Promote a same-route trace<br/>FUNCTION · route ownership/match then addExample<br/>input = last user msg, referenceOutput = trace output"]:::fn
  G["planned: Grow from production<br/>AGENT · propose judge-uncertain / drift / diverse candidates<br/>into a suggested-additions queue, USER accepts"]:::todo

  S -- "upload" --> U --> UV --> NV
  S -- "no upload" --> CTX --> A --> AV --> NV
  NV --> C --> CUR
  C --> PT --> CUR
  C -.-> G -.-> CUR

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef todo fill:#e5e7eb,stroke:#6b7280,color:#111827;
