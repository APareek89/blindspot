%% Blindspot — eval + recommend (PRD §3, §6, §7a): authorize spend, back-test, then propose
%% files: apps/gateway/src/manage/eval.ts, packages/core/src/eval/planner.ts, packages/core/src/eval/runner.ts, packages/core/src/recommend.ts
%% granularity: full
flowchart TD
  T["Select eligible candidate models + USD cap<br/>USER"]:::ask
  EST["Conservative full estimate<br/>FUNCTION · candidate + judge token ceilings<br/>zero provider calls"]:::fn
  FIT{"Cap covers full active golden set?<br/>FUNCTION"}:::dec
  SAMPLE["Deterministic stratified sample<br/>FUNCTION · must-pass, known-failure, edge, representative"]:::fn
  PLAN["Persist immutable 30-minute plan<br/>DATA · exact selected/omitted cases, strata, seed, calls, costs"]:::data
  OK{"Confirm disclosed plan?<br/>USER · explicit confirm = true"}:::ask
  LOCK["Lock + consume draft once<br/>FUNCTION · re-check ownership, eligibility and example hash"]:::fn
  RUN["runEval for each selected model/example<br/>FUNCTION · enforce authorized per-model cost before every call"]:::fn
  CAND["Candidate output<br/>AGENT · candidate model via user key<br/>in: example.input · out: text + usage + latency"]:::agent
  JUDGE["Judge score<br/>AGENT · JUDGE_MODEL<br/>in: output vs reference + rubric · out: score, criteria, reasoning"]:::agent
  ROW["Persist per-example output + issue evidence<br/>DATA · eval_example_results<br/>candidate/judge costs and errors"]:::data
  AGG["Aggregate score, latency, reported cost and failures<br/>DATA · eval_runs + eval_plans"]:::data
  POL{"Same-plan live + candidate evidence complete?<br/>FUNCTION · identical cases, scores, criteria and paired outputs"}:::dec
  VALUE{"Candidate passes bar and proves the policy claim?<br/>FUNCTION · cost mode requires comparable verified prices"}:::dec
  DUP{"Pending rec already exists for this target?<br/>FUNCTION"}:::dec
  REC["Create Recommendation + evidence<br/>DATA · recommendations status = pending<br/>criteria + cost/latency delta + samples"]:::data
  AUTO{"route.auto_approve ON and cost decreases?<br/>FUNCTION · default OFF"}:::dec
  APPLY["Lock decision + Route; verify evidence.from_model is still live<br/>FUNCTION · transactional status + live_model update, logged"]:::fn
  INBOX["Approvals inbox — USER approve or reject<br/>USER · approve applies swap, reject stores reason"]:::ask
  STOP["No recommendation<br/>FUNCTION · live model unchanged"]:::term

  T --> EST --> FIT
  FIT -- "yes" --> PLAN
  FIT -- "no" --> SAMPLE --> PLAN
  PLAN --> OK
  OK -- "revise" --> T
  OK -- "confirm" --> LOCK --> RUN
  RUN --> CAND --> JUDGE --> ROW --> AGG --> POL
  POL -- "no" --> STOP
  POL -- "yes" --> VALUE
  VALUE -- "no" --> STOP
  VALUE -- "yes" --> DUP
  DUP -- "yes" --> STOP
  DUP -- "no" --> REC --> AUTO
  AUTO -- "yes" --> APPLY
  AUTO -- "no" --> INBOX
  INBOX -- "approve" --> APPLY

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
