%% Blindspot — master flow: Connect -> Observe -> Eval -> Recommend -> Approve -> Apply (FMEA synced 2026-07-21)
%% files: packages/sdk/src/index.ts, packages/core/src/eval/planner.ts, packages/core/src/eval/runner.ts, packages/core/src/recommend.ts, packages/core/src/drift.ts
%% granularity: master
flowchart TD
  A["Existing agent handles a user request<br/>ENTRY · app keeps its own prompts, tools and deterministic code"]:::term
  MODE{"Connection mode?<br/>USER · observe-only is default"}:::dec
  OBS["Observe existing model calls and every node kind<br/>FUNCTION · SDK sends consent-bounded spans<br/>out: workflow map + generation Routes"]:::fn
  MAN["Resolve generation node to approved model<br/>FUNCTION · managed SDK or OpenAI-compatible gateway<br/>out: concrete provider:model"]:::fn
  LIVE["Run the real application workflow<br/>AGENT + FUNCTION nodes<br/>out: answer, spans, usage, errors and latency"]:::agent
  GOLD["Create versioned golden set<br/>USER · upload, documents, explicitly shared context, or consented live traces"]:::ask
  EST["Choose compatible models + execution mode; calculate budget<br/>FUNCTION · exact full/sample disclosure · no provider calls"]:::fn
  CONF{"Confirm exact paid plan?<br/>USER"}:::ask
  EVAL["Execute authorized examples and judge visible criteria<br/>AGENT · candidate + JUDGE_MODEL<br/>DATA · per-example evidence and criterion-mean score"]:::agent
  GRADE{"Evidence grade?<br/>FUNCTION"}:::dec
  SCREEN["Model-only screening result<br/>DATA · shortlist/issues only · cannot recommend production switch"]:::term
  POLICY{"Replay evidence complete and candidate passes bar with proven benefit?<br/>FUNCTION"}:::dec
  REC["Create evidence-backed Recommendation<br/>DATA · Approvals inbox · live app unchanged"]:::data
  DECIDE{"Approve or reject?<br/>USER"}:::ask
  APPLY{"Connection is managed?<br/>FUNCTION"}:::dec
  SWITCH["Apply approved route model<br/>FUNCTION · transactional stale-baseline check + audit log"]:::fn
  ROLLOUT["Mark awaiting app rollout<br/>DATA · observe-only never claims the app changed"]:::term
  DRIFT["Monitor live operational signals + replay-grade golden scores<br/>FUNCTION · simulations stay quarantined from evidence"]:::fn
  NOOP["Keep current model and visible issues<br/>DATA"]:::term

  A --> MODE
  MODE -- "observe-only" --> OBS --> LIVE
  MODE -- "managed" --> MAN --> LIVE
  LIVE --> GOLD --> EST --> CONF
  CONF -- "revise" --> EST
  CONF -- "confirm" --> EVAL --> GRADE
  GRADE -- "model-only" --> SCREEN
  GRADE -- "workflow replay" --> POLICY
  POLICY -- "no" --> NOOP
  POLICY -- "yes" --> REC --> DECIDE
  DECIDE -- "reject" --> NOOP
  DECIDE -- "approve" --> APPLY
  APPLY -- "yes" --> SWITCH --> DRIFT
  APPLY -- "no" --> ROLLOUT --> DRIFT
  DRIFT -. "new evidence" .-> POLICY

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
