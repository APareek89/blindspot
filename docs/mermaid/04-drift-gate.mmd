%% Blindspot — three drift lanes with simulations quarantined from evidence (takeover reviewed 2026-07-22)
%% files: packages/core/src/drift.ts, packages/core/src/eval/runner.ts, apps/gateway/src/manage/drift.ts, apps/dashboard/app/(app)/drift/page.tsx
%% granularity: full
flowchart TD
  SPAN["Production workflow spans<br/>DATA · model/version, errors, tokens, latency, permitted content"]:::data
  OPS["Store live operational signals<br/>FUNCTION · error, latency, usage and unexpected model-version changes<br/>automated threshold alerts remain Phase 8"]:::fn
  CAP{"Full content capture and semantic-judge budget authorized?<br/>USER + FUNCTION"}:::dec
  SEM["Planned live semantic sampling<br/>AGENT · JUDGE_MODEL<br/>in: consented live cases · out: quality trend"]:::agent
  GOLD["Completed authorized golden eval<br/>DATA · workflow-replay run on the live model"]:::data
  PREV["Load prior comparable live-model score<br/>FUNCTION · same route and golden version"]:::fn
  CMP{"New criterion-mean score below previous score minus margin?<br/>FUNCTION · margin default 0.05"}:::dec
  EVENT["Record real drift event<br/>DATA · source is live_traffic, provider_version or golden_eval"]:::data
  ALT{"Complete replay evidence has a passing alternative?<br/>FUNCTION"}:::dec
  REC["Create drift Recommendation with evidence<br/>DATA · Approvals inbox · no silent revert"]:::data
  ONLY["Keep drift event visible; no safe alternative yet<br/>DATA"]:::term
  CLEAR["No evidence-backed quality drift<br/>DATA"]:::term
  SIM["Developer simulation<br/>FUNCTION · source=simulation, action=none"]:::fn
  QUAR["Quarantined demo event<br/>DATA · excluded from overview, history, eval runs and Recommendations"]:::term

  SPAN --> OPS --> CAP
  CAP -- "yes" --> SEM --> EVENT
  CAP -- "no" --> CLEAR
  GOLD --> PREV --> CMP
  CMP -- "no" --> CLEAR
  CMP -- "yes" --> EVENT --> ALT
  ALT -- "yes" --> REC
  ALT -- "no" --> ONLY
  SIM --> QUAR

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
