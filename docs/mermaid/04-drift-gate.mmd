%% Blindspot — drift detection + CI gate (PRD §5)
flowchart TD
  TR["Trigger<br/>FUNCTION · schedule OR provider version bump OR manual drift-check"]:::fn
  RE{"Explicit simulated bump supplied?<br/>FUNCTION"}:::dec
  BLOCK["409: real paid drift eval requires an approved plan<br/>FUNCTION · Phase 8 queue handoff pending"]:::term
  SIM["Inject validated simulated newScore 0..1<br/>FUNCTION · writes a synthetic eval_runs row"]:::fn
  CMP{"Drift? newScore below (oldScore - margin) OR below policy bar<br/>FUNCTION · margin default 0.05"}:::dec
  OK["No drift — done<br/>FUNCTION"]:::term
  DE["Record drift_event<br/>DATA · drift_events (old/new score, action=recommended)"]:::data
  REC["generateRecommendation mode=drift<br/>FUNCTION · best PASSING candidate != live (cost secondary)"]:::fn
  HASC{"A passing candidate exists?<br/>FUNCTION"}:::dec
  INBOX["Approval-gated recommendation → inbox<br/>USER · approve applies swap"]:::ask
  NONE["drift_event only (no passing alternative yet)<br/>FUNCTION"]:::term

  G["CI Gate · POST /routes/:name/gate<br/>FUNCTION · 409 until it can consume an approved queued plan"]:::term

  TR --> RE
  RE -- "no" --> BLOCK
  RE -- "yes" --> SIM --> CMP
  CMP -- "no" --> OK
  CMP -- "yes" --> DE --> REC --> HASC
  HASC -- "yes" --> INBOX
  HASC -- "no" --> NONE

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
