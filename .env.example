# Blindspot — environment template. Copy to `.env` and fill. NEVER commit `.env`.
# Values here stay BLANK. Only presence is ever checked.

# --- providers (BYO keys; first prototype: Anthropic; adapters: HF + Fireworks) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=

# --- Claude-first model policy (recommended IDs are comments; keep values environment-owned) ---
# JUDGE_MODEL: anthropic:claude-haiku-4-5-20251001
# BLINDSPOT_DEFAULT_MODEL: anthropic:claude-sonnet-4-6
# GOLDEN_MODEL: anthropic:claude-sonnet-4-6
JUDGE_MODEL=
BLINDSPOT_DEFAULT_MODEL=
GOLDEN_MODEL=

# --- data + cache ---
DATABASE_URL=
REDIS_URL=
BLINDSPOT_EVAL_MODE=

# --- security (encrypts users' stored provider keys at rest; openssl rand -hex 32) ---
ENCRYPTION_KEY=

# --- ops (optional, free tiers) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
COST_CAP_USD_PER_EVAL_RUN=1

# --- app-side connector (set these in the agent app, not the Blindspot server) ---
BLINDSPOT_API_KEY=
BLINDSPOT_BASE_URL=
BLINDSPOT_ENVIRONMENT=
BLINDSPOT_CAPTURE=
BLINDSPOT_ROUTING=

# App-owned secret for the protected replay callback; configure the same value in the
# app and through Blindspot's Workflows UI. Never reuse BLINDSPOT_API_KEY.
BLINDSPOT_REPLAY_SECRET=
